# Loopback HTTP port. Put TLS/authenticated ingress in front for remote use.
PORT=8787
# Shared bearer token used only for server-to-server note verification.
GHOSTMODE_SELLER_VERIFIER_TOKEN=generate-with-openssl-rand-hex-32

# Starknet Sepolia RPC and the dedicated seller account. The account/private key
# must match; use a purpose-built low-value identity.
SELLER_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_KEY
SELLER_ACCOUNT_ADDRESS=0x...
SELLER_ACCOUNT_PRIVATE_KEY=0x...
# Permanent seller viewing key. Changing it changes note discovery identity.
SELLER_VIEWING_KEY=0x...

# Official pool plus distinct proving and discovery/indexer services. An RPC URL
# cannot replace the latter two.
STRK20_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
STRK20_PROVING_SERVICE_URL=https://...
STRK20_INDEXER_URL=https://...
