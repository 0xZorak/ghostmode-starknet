# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key — used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_key_here

# Optional full browser RPC overrides. These values are bundled into the client;
# use provider keys that are safe for public dapps and restrict them at the RPC.
NEXT_PUBLIC_STARKNET_SEPOLIA_RPC_URL=
NEXT_PUBLIC_STARKNET_MAINNET_RPC_URL=

# Optional explicit pool override for the selected network. Leave blank to use
# the verified address pinned in src/utils/constants.ts.
NEXT_PUBLIC_PRIVACY_POOL_ADDRESS=

# Optional server/CLI RPC overrides. These are never returned by /api/health.
GHOSTMODE_SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
GHOSTMODE_MAINNET_RPC_URL=https://api.cartridge.gg/x/starknet/mainnet

# Required for hosted/private-purchase operation. Local development may omit it
# and uses an explicitly non-durable in-memory store.
DATABASE_URL=

# Sepolia-first safety switch. Change this to mainnet only after every release
# check in docs/MAINNET_RUNBOOK.md passes.
NEXT_PUBLIC_GHOSTMODE_NETWORK=sepolia

# GhostMode Sepolia purchase flow. The seller must already be registered with
# the Sepolia STRK20 pool. Deploy cairo/src/lib.cairo with that pool address,
# then set the resulting contract address here. Zero addresses disable submit.
NEXT_PUBLIC_GHOSTMODE_GATE_SEPOLIA=0x0
NEXT_PUBLIC_GHOSTMODE_SELLER_SEPOLIA=0x0

# Server-only: a trusted service that holds the seller's viewing key and confirms
# discovery of the exact private payment note. Never prefix these with NEXT_PUBLIC_.
GHOSTMODE_SELLER_VERIFIER_URL=
GHOSTMODE_SELLER_VERIFIER_TOKEN=

# Server-only Stark-curve key used only to sign opaque receipt requests. It is
# not a Starknet account spending key. Deploy ReceiptGate with the matching
# public key as constructor argument 2. Never prefix this with NEXT_PUBLIC_.
GHOSTMODE_QUOTE_SIGNER_PRIVATE_KEY=
GHOSTMODE_QUOTE_SIGNER_PUBLIC_KEY=

# Mainnet safeguards. Leave false during Sepolia development. The test-mode flag
# allows the UI/server demo preflight; the deployment flag authorizes only the
# guarded ReceiptGate deployment command, not token movements.
CONFIRM_MAINNET_TEST_MODE=false
CONFIRM_MAINNET_DEPLOYMENT=false

# Optional overrides used only by scripts/deploy-mainnet.sh. They are not read by
# the web app and must point to a gitignored sncast account file.
SNCAST_BIN=
SNCAST_ACCOUNTS_FILE=
SNCAST_MAINNET_ACCOUNT_NAME=ghostmode_mainnet_deployer

# Reserved for the deliberate mainnet promotion. Leave zero during testing.
NEXT_PUBLIC_GHOSTMODE_GATE_MAINNET=0x0
NEXT_PUBLIC_GHOSTMODE_SELLER_MAINNET=0x0

# (Optional) Your echo/anonymizer helper deployed on Sepolia — enables the Echo
# action there. Leave as 0x0 if not deployed; you can deploy one from the Echo tab
# in the app and paste the returned address here.
NEXT_PUBLIC_STRK20_ECHO_HELPER_SEPOLIA=0x0
