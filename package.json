{
  "name": "ghostmode-starknet",
  "version": "0.1.0",
  "description": "Privacy-aware execution and private payment infrastructure for AI agents on Starknet.",
  "license": "MIT",
  "private": true,
  "bin": {
    "ghostmode": "bin/ghostmode.mjs"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --webpack",
    "build": "node scripts/run-next.mjs build --webpack",
    "start": "node scripts/run-next.mjs start",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm --prefix seller-verifier run check && npm run build",
    "check:full": "npm run check && npm run contracts:test",
    "contracts:test": "cd cairo && scarb test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "doctor": "node --env-file-if-exists=.env.local --env-file-if-exists=.secrets/quote-signer.env bin/ghostmode.mjs doctor",
    "health:sepolia": "node --env-file-if-exists=.env.local --env-file-if-exists=.secrets/quote-signer.env bin/ghostmode.mjs status",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "demo:check": "node scripts/demo-check.mjs",
    "demo": "npm run demo:check && node scripts/run-next.mjs dev --webpack",
    "keys:quote": "node scripts/generate-quote-signer.mjs",
    "quote-signer:generate": "npm run keys:quote",
    "gate:account:create": "bash scripts/gate-deployment.sh create-account",
    "gate:account:deploy": "bash scripts/gate-deployment.sh deploy-account",
    "gate:deploy": "bash scripts/gate-deployment.sh deploy-gate",
    "gate:verify": "node scripts/verify-gate.mjs",
    "deploy:sepolia": "bash scripts/gate-deployment.sh deploy-gate",
    "mainnet:check": "node scripts/network-check.mjs mainnet",
    "mainnet:readiness": "node --env-file-if-exists=.env.local scripts/mainnet-readiness.mjs",
    "mainnet:dry-run": "node scripts/network-check.mjs mainnet --dry-run",
    "deploy:mainnet": "bash scripts/deploy-mainnet.sh"
  },
  "dependencies": {
    "@starknet-io/get-starknet-discovery": "6.0.3",
    "@starknet-io/get-starknet-wallet-standard": "6.0.3",
    "next": "^16.0.8",
    "postgres": "^3.4.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "^0.35.3",
    "starknet": "10.4.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@starknet-io/types-js": "0.10.3",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@starknet-io/get-starknet-discovery": {
      "@starknet-io/get-starknet-virtual-wallet": "6.0.3",
      "@starknet-io/get-starknet-wallet-standard": "6.0.3"
    },
    "@starknet-io/get-starknet-virtual-wallet": {
      "@starknet-io/get-starknet-wallet-standard": "6.0.3"
    }
  },
  "packageManager": "npm@11.6.2"
}
